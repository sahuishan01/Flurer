{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "flurer",
  "version": "0.4.106",
  "identifier": "com.algosculptor.flurer",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Flurer",
        "width": 800,
        "height": 600,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/32x32.png": "icons/drag-icon.png",
      "target/release/flurer-watchd.exe": "flurer-watchd.exe"
    },
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerHooks": "installer/watchd-service-hooks.nsh"
      }
    }
  }
}
