{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window and every window spawned by the global shortcut — grants all plugins access to shell execution and core APIs",
  "windows": ["main", "flurer-*"],
  "permissions": [
    "core:default",
    "opener:default",
    "opener:allow-open-path",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "git",
          "cmd": "git",
          "args": true,
          "sidecar": false
        },
        {
          "name": "sh",
          "cmd": "sh",
          "args": true,
          "sidecar": false
        }
      ]
    }
  ]
}